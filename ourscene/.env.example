# Deployed apps need decentralized mode to communicate across origins.
VITE_GRAFFITI_MODE=decentralized
# Set each to the real Graffiti actor for that venue. Handles are not actor IDs.
VITE_BLUE_HOUR_ACTOR=
VITE_RED_ROOM_ACTOR=
VITE_LANTERN_ACTOR=
VITE_SIGNAL_YARD_ACTOR=
# Optional full deployment URLs for navigation between independently hosted apps.
VITE_AGGREGATOR_URL=
VITE_BLUE_HOUR_URL=
VITE_RED_ROOM_URL=
VITE_LANTERN_URL=
VITE_SIGNAL_YARD_URL=
# Optional tile provider overrides. Default: standard OpenStreetMap tiles.
# All provider settings are public. Private credentials do not belong here.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION_TEXT=© OpenStreetMap contributors
VITE_MAP_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright
# VITE_ settings are public configuration; never put credentials here.
